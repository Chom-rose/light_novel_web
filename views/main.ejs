<%- include('includes/head') %>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    /* Swiper */
    @import url('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css');
  
    /* การ์ดนิยายที่ JS เติมเข้ามา */
    #novelList article,
    #popularNovels .swiper-slide {
      background: #fff;
      border-radius: 10px;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      cursor: pointer;
    }
  
    /* เอฟเฟกต์ hover */
    #novelList article:hover,
    #popularNovels .swiper-slide:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.18);
    }
  </style>
  </head>

  <body>
    <%- include('includes/nav') %>
      <main>
        <!-- Slider -->
        <section class="max-w-7xl mx-auto px-4 py-6">
          <h2 class="text-xl font-bold mb-4">นิยาย</h2>
          <div class="swiper popularSwiper">
            <div id="popularNovels" class="swiper-wrapper">
              <!-- 👇 JS จะเติมนิยายจริงตรงนี้ -->
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-pagination"></div>
          </div>
        </section>
        

        <!-- Latest Updates -->
        <section class="max-w-7xl mx-auto px-4 py-10 space-y-12">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-bold">นิยายมาใหม่</h3>
            <a href="/search" class="text-sm text-indigo-600 hover:underline">ดูทั้งหมด</a>
          </div>
          <!-- 👇 JS จะเติมนิยายจริงตรงนี้ -->
          <div id="novelList" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4"></div>
        </section>
      </main>

      <!-- Overlay กล่องค้นหา -->
      <div id="searchOverlay" class="fixed inset-0 bg-black/40 flex items-start justify-center pt-3 hidden z-50">
        <div class="bg-white shadow-lg rounded-lg p-6 w-full max-w-3xl relative">
          <!-- ปุ่มปิด -->
          <button id="closeSearch" class="absolute top-2 right-2 text-gray-600">✕</button>

          <form action="/search" method="get" class="flex flex-col gap-3">
            <input type="text" name="q" placeholder="ค้นหาชื่อเรื่องหรือผู้แต่ง" class="border rounded-lg px-3 py-2" />

            <select name="category" class="border rounded-lg px-3 py-2">
              <option value="">-- ทุกแนว --</option>
              <option value="Romance">Romance</option>
              <option value="Fantasy">Fantasy</option>
              <option value="Action">Action</option>
            </select>

            <select name="type" class="border rounded-lg px-3 py-2">
              <option value="">-- ทุกประเภท --</option>
              <option value="short">นิยายสั้น</option>
              <option value="long">นิยายยาว</option>
            </select>

            <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg">ค้นหา</button>
          </form>
        </div>
      </div>


      <%- include('includes/footer') %>
      <script src="/js/main.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
        <%- include('includes/chatbot') %>
      <script src="/js/search.js"></script>
          

  </body>

  </html>